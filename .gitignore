# ---------------------------------------------------------------
# Unity generated folders - all rebuilt on open, never commit them
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files for assets that ARE tracked - Unity needs them
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------
# IDE / solution files (regenerated by Unity on demand)
# ---------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
ExportedObj/
.consulo/
.idea/
.vs/
.vscode/

# ---------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
[Bb]urst[Dd]ebug[Ii]nformation_*/

# ---------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Third-party Asset Store content (527 MB of 4K textures).
# Re-import from the Asset Store instead of committing licensed
# binaries. Nothing in Assets/AetherCitadel depends on it.
# Delete these two lines to start tracking it.
# ---------------------------------------------------------------
/Assets/Desert City Pack/
/Assets/Desert City Pack.meta
